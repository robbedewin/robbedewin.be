---
interface Props {
  href: string;
  title: string;
  summary: string;
  kicker?: string;
  tags?: string[];
  variant?: 'tile' | 'row';
}
const { href, title, summary, kicker, tags = [], variant = 'tile' } = Astro.props;
const tagLine = tags.map((t) => t.toLowerCase()).join(' · ');
---

<li>
  <a class={variant} href={href}>
    {kicker && <span class={`${variant}__kicker`}>{kicker}</span>}
    {variant === 'tile' ? (
      <>
        <span class="tile__title">{title}</span>
        <span class="tile__summary">{summary}</span>
        {tagLine && <span class="tile__tags">{tagLine}</span>}
      </>
    ) : (
      <span class="row__body">
        <span class="row__title">{title}</span>
        <span class="row__summary">{summary}</span>
        {tagLine && <span class="row__tags">{tagLine}</span>}
      </span>
    )}
  </a>
</li>
