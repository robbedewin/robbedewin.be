---

<ul class="social">
  {links.map((l) => (
    <li>
      <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d={l.path}
            fill={l.fill ? 'currentColor' : 'none'}
            stroke={l.fill ? 'none' : 'currentColor'}
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        {l.label}
      </a>
    </li>
  ))}
</ul>
