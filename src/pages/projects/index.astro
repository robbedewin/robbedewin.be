---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Projects"
  description="Genome-scale metabolic modelling, sequencing pipelines, a Belgian financial planning engine, and a local-first bike garage."
>
  <div class="page-head">
    <p class="prompt">ls projects/</p>
    <h1>Projects</h1>
    <p class="page-head__summary">
      Two master's theses and five things I built because I wanted them to exist.
    </p>
  </div>

  <ul class="rows">
    {projects.map((p) => (
      <ProjectCard
        variant="row"
        href={`/projects/${p.id}`}
        kicker={p.data.kicker}
        title={p.data.title}
        summary={p.data.summary}
        tags={p.data.tags}
      />
    ))}
  </ul>
</Base>
