---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist." noindex={true}>
  <div class="page-head">
    <p class="prompt">cd ./that-page</p>
    <h1>No such file or directory</h1>
    <p class="page-head__summary">
      That page does not exist. It may have moved, or the link may be wrong.
    </p>
  </div>
  <p class="mono">
    <a href="/">~/</a> · <a href="/projects">./projects</a> ·
    <a href="/research">./research</a> · <a href="/cv">./cv</a>
  </p>
</Base>
