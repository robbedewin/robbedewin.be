---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Robbe De Win"
  description="Bioinformatics-trained and data-driven, in Leuven, Belgium. Data pipelines, decision tools and automation, built to be reproducible."
>
  <section class="hero">
    <p class="prompt">whoami</p>
    <h1>Robbe De Win<span class="caret" aria-hidden="true"></span></h1>
    <p class="hero__lede">
      Bioinformatics-trained, data-driven. I use data to make decisions and
      automate what shouldn't be manual.
    </p>
    <p class="hero__body">
      A thousand genomes is not a bigger version of one genome, it is a different
      problem. That's the part I like: getting it to run reliably, validating it
      against experimental data, and being able to say exactly how each number was
      produced.
    </p>
    <SocialLinks />
  </section>

  <dl class="facts" aria-label="Background">
    <div>
      <dt>education</dt>
      <dd>
        MSc Bioinformatics<br />
        MSc Biomedical Sciences<br />
        <span class="muted">KU Leuven</span>
      </dd>
    </div>
    <div>
      <dt>looking for</dt>
      <dd>First role in data science, analytics or automation, using data to drive decisions</dd>
    </div>
    <div>
      <dt>where</dt>
      <dd>Flanders, Brussels, or remote from Leuven</dd>
    </div>
    <div>
      <dt>languages</dt>
      <dd>Dutch, English</dd>
    </div>
  </dl>

  <div class="section-head">
    <h2>Projects</h2>
    <a href="/projects">ls projects/ →</a>
  </div>
  <ul class="card-grid">
    {featured.map((p) => (
      <ProjectCard
        href={`/projects/${p.id}`}
        kicker={p.data.kicker}
        title={p.data.title}
        summary={p.data.summary}
        tags={p.data.tags}
      />
    ))}
  </ul>
</Base>
