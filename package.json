{
  "name": "robbedewin-be",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "hooks:install": "git config core.hooksPath scripts && chmod +x scripts/pre-commit && echo \"leak guard installed (core.hooksPath=scripts)\"",
